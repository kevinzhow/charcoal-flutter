      "small": {
        "gap": "{space.component/10}",
        "height": "{space.target/s}",
        "icon-size": "{space.component/30}",
        "font-size": "{text.font-size/caption/m}",
        "font-weight": "{text.font-weight/bold}",
        "line-height": "{text.line-height/caption/m}",
        "padding-horizontal": "{space.component/30}",
        "radius": "{radius.oval}"
      },
      "medium": {
        "gap": "{space.component/10}",
        "height": "{space.target/m}",
        "icon-size": "{space.component/30}",
        "font-size": "{text.font-size/caption/m}",
        "font-weight": "{text.font-weight/bold}",
        "line-height": "{text.line-height/caption/m}",
        "padding-horizontal": "{space.component/40}",
