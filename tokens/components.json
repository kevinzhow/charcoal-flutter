    "variants": {
      "default": {
        "background": {
          "disabled": "{color.container/secondary/default-a}",
          "hovered": "{color.container/secondary/hover-a}",
          "normal": "{color.container/secondary/default-a}",
          "pressed": "{color.container/secondary/press-a}"
        },
        "foreground": {
          "disabled": "{color.text/default}",
          "hovered": "{color.text/hover}",
          "normal": "{color.text/default}",
          "pressed": "{color.text/press}"
