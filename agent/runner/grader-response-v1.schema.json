{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charcoal-flutter.dev/schemas/agent-grader-response-v1.json",
  "title": "Charcoal benchmark grader response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "scores", "hardFailures", "rationale"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiAccuracy",
        "charcoalComposition",
        "tokenAndLayout",
        "accessibility",
        "responsiveness",
        "verification"
      ],
      "properties": {
        "apiAccuracy": { "type": "number", "minimum": 0, "maximum": 20 },
        "charcoalComposition": { "type": "number", "minimum": 0, "maximum": 15 },
        "tokenAndLayout": { "type": "number", "minimum": 0, "maximum": 10 },
        "accessibility": { "type": "number", "minimum": 0, "maximum": 10 },
        "responsiveness": { "type": "number", "minimum": 0, "maximum": 10 },
        "verification": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    },
    "hardFailures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["fabricated_charcoal_api", "silent_platform_substitution"]
      }
    },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiAccuracy",
        "charcoalComposition",
        "tokenAndLayout",
        "accessibility",
        "responsiveness",
        "verification"
      ],
      "properties": {
        "apiAccuracy": { "type": "string", "minLength": 1 },
        "charcoalComposition": { "type": "string", "minLength": 1 },
        "tokenAndLayout": { "type": "string", "minLength": 1 },
        "accessibility": { "type": "string", "minLength": 1 },
        "responsiveness": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 }
      }
    }
  }
}
