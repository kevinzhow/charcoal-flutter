    { "name": "1440x900", "width": 1440, "height": 900 },
    { "name": "390x844", "width": 390, "height": 844 },
    { "name": "320x700", "width": 320, "height": 700 }
  ],
  "themes": ["light", "dark"],
  "pages": [
    { "id": "overview", "nav": "Overview" },
    { "id": "agent-apps", "nav": "Agent Ready apps" },
    { "id": "colors", "nav": "Colors" },
    { "id": "typography", "nav": "Typography" },
    { "id": "dimensions", "nav": "Dimensions" },
    { "id": "icons", "nav": "Icons" },
    { "id": "buttons", "nav": "Buttons" },
    { "id": "selection", "nav": "Selection" },
    { "id": "tags", "nav": "Tags" },
    { "id": "roles", "nav": "Roles" },
    { "id": "fields", "nav": "Fields" },
    { "id": "navigation", "nav": "Navigation" },
    { "id": "layout", "nav": "Layout" },
    { "id": "admin", "nav": "Admin" },
    { "id": "content", "nav": "Content" },
    { "id": "feedback", "nav": "Feedback" },
    { "id": "token-pipeline", "nav": "Token pipeline" },
    { "id": "app-nook", "nav": "Agent Ready apps", "steps": [{ "click": "Open Nook simulation" }] },
    { "id": "app-lumen", "nav": "Agent Ready apps", "steps": [{ "click": "Open Lumen simulation" }] },
    { "id": "app-daylight", "nav": "Agent Ready apps", "steps": [{ "click": "Open Daylight simulation" }] },
    { "id": "app-bloom", "nav": "Agent Ready apps", "steps": [{ "click": "Open Bloom simulation" }] },
    { "id": "app-aster", "nav": "Agent Ready apps", "steps": [{ "click": "Aster" }], "optional": true }
