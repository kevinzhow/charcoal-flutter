        "foreground": {
          "disabled": "{color.text/on-negative/default}",
          "hovered": "{color.text/on-negative/hover}",
          "normal": "{color.text/on-negative/default}",
          "pressed": "{color.text/on-negative/press}"
        }
      },
      "navigation": {
        "background": {
          "disabled": "{color.container/hud/default}",
          "hovered": "{color.container/hud/hover}",
          "normal": "{color.container/hud/default}",
          "pressed": "{color.container/hud/press}"
