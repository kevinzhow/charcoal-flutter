{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charcoal-flutter.dev/schemas/agent-benchmark-suite-v1.json",
  "title": "Charcoal Agent Ready benchmark suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogSchemaVersion",
    "libraryVersion",
    "suite",
    "cases"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogSchemaVersion": { "type": "integer", "minimum": 1 },
    "libraryVersion": { "type": "string", "minLength": 1 },
    "suite": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "expectedComponents",
        "requiredAssertions",
        "forbiddenPatterns"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "expectedComponents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredAssertions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbiddenPatterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
